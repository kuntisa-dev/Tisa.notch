    "%@  (%@)" : {
      "comment" : "A button that lets the user select a temperature sensor. The label shows the sensor name and its key.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@  (%2$@)"
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "A contextual menu item that opens a file.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %@ · mode key %@" : {
      "comment" : "A label displaying the key, value type, and mode key of a fan. The first argument is the fan key. The second argument is the value type of the fan. The third argument is the mode key of the fan.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@ · mode key %3$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "A label displaying the current version of the app, including both the short and build versions.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ always uses %lld photos" : {
      "comment" : "A label that shows the number of photos used in a specific photo booth style. The argument is the number of photos.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ always uses %2$lld photos"
          }
        }
      }
    },
    "%@ is also a tab in the top bar" : {
      "comment" : "A help tag that explains what a button in the widget gallery does.",
      "isCommentAutoGenerated" : true
    },
    "%@ is built-in and cannot change — editing it saves your settings as a profile of your own" : {
      "comment" : "A tooltip for the \"Edit\" button in the profiles view, explaining that built-in profiles cannot be edited but can be duplicated or renamed. The argument is the name of the profile.",
      "isCommentAutoGenerated" : true
    },
