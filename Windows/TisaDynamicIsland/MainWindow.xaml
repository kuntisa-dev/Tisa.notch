<Window x:Class="TisaDynamicIsland.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Tisa Dynamic Island" Width="420" Height="64" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
 FontFamily="Segoe UI Variable, Segoe UI" PreviewKeyDown="OnKeyDown" UseLayoutRounding="True">
 <Border x:Name="Island" BorderBrush="#40536B78" BorderThickness="1" CornerRadius="0,0,26,26"
  Padding="14,8,14,14" VerticalAlignment="Top" MouseEnter="OnIslandEnter" MouseLeave="OnIslandLeave"
  AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FC17222D"/><GradientStop Color="#FC10171F" Offset="1"/></LinearGradientBrush></Border.Background>
  <StackPanel>
   <Grid Height="34">
    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource Accent}" HorizontalAlignment="Left"><TextBlock Text="T" Foreground="#12251F" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <Button Grid.Column="1" Click="ToggleExpanded" Padding="0" Background="Transparent" HorizontalContentAlignment="Stretch" ToolTip="Expand or collapse the island" AutomationProperties.Name="Expand or collapse island">
     <TextBlock x:Name="CompactTitle" Text="Tisa Dynamic Island" TextTrimming="CharacterEllipsis"/>
    </Button>
    <StackPanel Grid.Column="2" Orientation="Horizontal">
     <TextBlock x:Name="Battery" FontSize="11" VerticalAlignment="Center" Margin="8,0" Foreground="#A7B5C4" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
     <Button x:Name="PinButton" Content="Pin" Click="TogglePin" Padding="8,4" ToolTip="Keep the island open" AutomationProperties.Name="Pin island open"/>
     <Button x:Name="CollapseButton" Content="⌄" Click="ToggleExpanded" Padding="8,4" ToolTip="Expand or collapse" AutomationProperties.Name="Expand or collapse"/>
    </StackPanel>
   </Grid>
   <StackPanel x:Name="Expanded" Visibility="Collapsed">
    <ScrollViewer x:Name="NavigationViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0" Height="52" Margin="0,12,0,12" SizeChanged="NavigationSizeChanged" AutomationProperties.Name="Page navigation">
    <UniformGrid x:Name="TabBar" Columns="5" Height="44" VerticalAlignment="Top" HorizontalAlignment="Left">
     <RadioButton Content="Home" Tag="Home" GroupName="Page" Style="{StaticResource Tab}" IsChecked="True" Checked="SelectTab"/>
     <RadioButton Content="Clipboard" Tag="Clipboard" GroupName="Page" Style="{StaticResource Tab}" Checked="SelectTab"/>
     <RadioButton Content="Downloads" Tag="Downloads" GroupName="Page" Style="{StaticResource Tab}" Checked="SelectTab"/>
     <RadioButton Content="Shelf" Tag="Shelf" GroupName="Page" Style="{StaticResource Tab}" Checked="SelectTab"/>
     <RadioButton Content="Settings" Tag="Settings" GroupName="Page" Style="{StaticResource Tab}" Checked="SelectTab"/>
    </UniformGrid></ScrollViewer>
    <Grid Height="250" x:Name="PageArea">
     <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid MinHeight="240">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition x:Name="OverviewColumn"/></Grid.ColumnDefinitions>
      <Border Background="#283B4B59" CornerRadius="18" Padding="18" Margin="0,0,12,0">
       <StackPanel>
        <TextBlock Text="NOW PLAYING" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Width="64" Height="64" CornerRadius="12" Background="#334A5B6C" ClipToBounds="True" VerticalAlignment="Top">
          <Grid><TextBlock x:Name="ArtworkPlaceholder" Text="♫" FontSize="32" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Artwork" Stretch="UniformToFill"/></Grid>
         </Border>
         <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="TrackTitle" Text="Your music, right here" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="TrackArtist" TextWrapping="Wrap" MaxHeight="40" Foreground="#A7B5C4" Margin="0,6,0,0"/></StackPanel>
        </Grid>
        <Slider x:Name="SeekSlider" Margin="0,18,0,0" Minimum="0" Maximum="1" IsEnabled="False" IsMoveToPointEnabled="True" PreviewMouseLeftButtonUp="SeekTrack" PreviewKeyUp="SeekTrack" AutomationProperties.Name="Playback position"/>
        <DockPanel Margin="0,3,0,7"><TextBlock x:Name="Elapsed" Text="0:00" FontSize="10" Foreground="#A7B5C4"/><TextBlock x:Name="TrackDuration" Text="0:00" FontSize="10" Foreground="#A7B5C4" HorizontalAlignment="Right"/></DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
         <Button x:Name="PreviousButton" Content="" FontFamily="Segoe Fluent Icons" Tag="previous" Click="MediaCommand" IsEnabled="False" ToolTip="Previous track" AutomationProperties.Name="Previous track"/>
         <Button x:Name="PlayButton" Content="" FontFamily="Segoe Fluent Icons" Tag="toggle" Click="MediaCommand" Background="#316657" IsEnabled="False" ToolTip="Play or pause" AutomationProperties.Name="Play or pause" Padding="24,10"/>
         <Button x:Name="NextButton" Content="" FontFamily="Segoe Fluent Icons" Tag="next" Click="MediaCommand" IsEnabled="False" ToolTip="Next track" AutomationProperties.Name="Next track"/>
        </StackPanel>
       </StackPanel>
      </Border>
      <Border x:Name="OverviewCard" Grid.Column="1" Background="#20374653" CornerRadius="18" Padding="16">
       <StackPanel><TextBlock Text="YOUR DAY" FontSize="10" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
        <TextBlock x:Name="Today" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,12"/>
        <TextBlock x:Name="Summary" TextWrapping="Wrap" Foreground="#A7B5C4" LineHeight="23"/>
        <Button Content="Open Downloads" Click="OpenDownloads" Margin="0,14,0,0"/>
       </StackPanel>
      </Border>
     </Grid></ScrollViewer>
     <Grid x:Name="ClipboardPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8"><Button x:Name="ClearClipboardButton" Content="Clear history" Click="ClearClipboard" DockPanel.Dock="Right"/>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="Clipboard history" FontWeight="SemiBold" FontSize="18"/><TextBlock x:Name="ClipboardHint" TextWrapping="Wrap" FontSize="11" Foreground="#A7B5C4" Margin="0,4,8,0"/></StackPanel></DockPanel>
      <Grid Grid.Row="1"><ListBox x:Name="ClipboardList" SelectionChanged="CopyEntry" AutomationProperties.Name="Clipboard history">
       <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"/><Image Source="{Binding Image}" MaxHeight="70" HorizontalAlignment="Left" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox><StackPanel x:Name="ClipboardEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="A little space for your next copy" FontSize="18" HorizontalAlignment="Center"/>
       <TextBlock Text="Copy text or an image to see it here." Foreground="#A7B5C4" HorizontalAlignment="Center" Margin="0,8,0,8"/>
       <Button x:Name="EnableClipboardButton" Content="Enable clipboard history" Click="EnableClipboard" HorizontalAlignment="Center"/>
      </StackPanel></Grid>
     </Grid>
     <Grid x:Name="DownloadsPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8"><Button Content="Open folder" Click="OpenDownloads" DockPanel.Dock="Right"/>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="Downloads" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DownloadHint" Foreground="#A7B5C4" FontSize="11" Margin="0,4,8,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
      <Grid Grid.Row="1"><ListBox x:Name="DownloadsList" AutomationProperties.Name="Active downloads"><ListBox.ItemTemplate><DataTemplate>
       <Border Background="#233E505F" CornerRadius="10" Padding="10"><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#A7B5C4" Margin="0,6,0,0"/></StackPanel></Border>
      </DataTemplate></ListBox.ItemTemplate></ListBox>
      <TextBlock x:Name="DownloadsEmpty" Text="All caught up" FontSize="20" Foreground="#A7B5C4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
     </Grid>
     <Grid x:Name="ShelfPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8"><Button x:Name="ClearShelfButton" Content="Clear shelf" Click="ClearShelf" DockPanel.Dock="Right"/>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="File shelf" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Double-click to open · drag to another app · Delete to remove" Foreground="#A7B5C4" FontSize="11" Margin="0,4,8,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
      <Grid Grid.Row="1"><ListBox x:Name="ShelfList" MouseDoubleClick="OpenShelfItem" PreviewMouseLeftButtonDown="BeginShelfDrag" PreviewMouseMove="DragShelfItem" PreviewKeyDown="ShelfKeyDown" AutomationProperties.Name="File shelf">
       <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="#A7B5C4" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox><Border x:Name="ShelfEmpty" BorderBrush="#50647F8D" BorderThickness="1" CornerRadius="16" Background="#15384B5A"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
       <TextBlock Text="Drop it here. Pick it up later." FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="Files stay in their original folders." Foreground="#A7B5C4" Margin="0,8,0,0" HorizontalAlignment="Center"/>
      </StackPanel></Border></Grid>
     </Grid>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
       <TextBlock Text="Make it yours" FontSize="20" FontWeight="SemiBold" Margin="6,0,0,12"/>
       <CheckBox x:Name="ClipboardToggle" Content="Keep clipboard history in memory" Click="SaveSettings"/>
       <TextBlock Text="Off by default. History clears when you lock Windows or quit." Foreground="#A7B5C4" FontSize="11" Margin="26,0,0,4" TextWrapping="Wrap"/>
       <CheckBox x:Name="DownloadsToggle" Content="Watch my Downloads folder" Click="SaveSettings"/>
       <CheckBox x:Name="HoverToggle" Content="Expand when I hover over the island" Click="SaveSettings"/>
       <TextBlock Text="Desktop &amp; displays" FontSize="16" FontWeight="SemiBold" Margin="6,16,0,10"/>
       <TextBlock Text="Show the island on" Foreground="#A7B5C4" Margin="6,0,0,6"/>
       <ComboBox x:Name="DisplaySelector" DisplayMemberPath="Label" SelectedValuePath="DeviceName" Margin="6,0,6,6" Padding="8" SelectionChanged="SelectDisplay" AutomationProperties.Name="Island display"/>
       <TextBlock x:Name="DisplayHint" Foreground="#A7B5C4" FontSize="11" Margin="6,0,6,6" TextWrapping="Wrap"/>
       <CheckBox x:Name="WideToggle" Content="Use a wider workspace on large monitors" Click="SaveSettings"/>
       <CheckBox x:Name="FloatingToggle" Content="Float below the top edge" Click="SaveSettings"/>
       <CheckBox x:Name="FullscreenToggle" Content="Hide over full-screen apps on this display" Click="SaveSettings"/>
       <WrapPanel Margin="3,8,0,10"><Button Content="Hide to tray" Click="HideToTray"/><Button Content="Display settings" Click="OpenDisplaySettings"/><Button Content="Windows power settings" Click="OpenPowerSettings"/></WrapPanel>
       <TextBlock x:Name="ShortcutHint" Text="Ctrl + Alt + Space opens the island. Escape collapses it." Foreground="#A7B5C4" TextWrapping="Wrap" FontSize="11" Margin="6,0,0,12"/>
       <Expander x:Name="FeatureAvailability" Header="Feature availability on Windows" Foreground="White" Margin="6,4,0,4">
        <StackPanel Margin="8,12,8,8">
         <TextBlock Text="Only available Windows features appear in the tabs and settings." TextWrapping="Wrap" Margin="0,0,0,12"/>
         <TextBlock Text="macOS only" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
         <TextBlock Text="AirDrop, Apple's Liquid Glass material and Apple SMC fan control are macOS features. They are not included on Windows." TextWrapping="Wrap" Foreground="#A7B5C4" Margin="0,4,0,12"/>
         <TextBlock Text="Not yet in this Windows build" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
         <TextBlock Text="Photo Booth, camera effects, Khmer calendar and routines, AI usage, editable Home widgets, microphone controls and advanced audio controls are not yet available. Their controls are hidden." TextWrapping="Wrap" Foreground="#A7B5C4" Margin="0,4,0,12"/>
         <TextBlock Text="PC fan control" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
         <TextBlock Text="Use your PC maker's fan utility for now. This app has no fan controller connected. Support depends on your PC's hardware; Windows power settings do not directly set fan speed." TextWrapping="Wrap" Foreground="#A7B5C4" Margin="0,4,0,8"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <TextBlock x:Name="Status" Text="Ctrl + Alt + Space to open · Escape to collapse" FontSize="11" Foreground="#A7B5C4" TextTrimming="CharacterEllipsis" Margin="4,14,0,0" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
