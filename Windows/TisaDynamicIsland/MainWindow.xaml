<Window x:Class="TisaDynamicIsland.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Tisa Dynamic Island" Width="760" Height="340" WindowStyle="None"
 AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True"
 ShowInTaskbar="False" FontFamily="Segoe UI" PreviewKeyDown="OnKeyDown">
 <Border x:Name="Island" Background="#F010151C" BorderBrush="#404C626D" BorderThickness="1"
  CornerRadius="0,0,28,28" Padding="16,8,16,16" VerticalAlignment="Top"
  MouseEnter="OnIslandEnter" MouseLeave="OnIslandLeave" AllowDrop="True" Drop="OnDrop">
  <StackPanel>
   <Grid Height="34">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="●" Foreground="{StaticResource Accent}" FontSize="20" VerticalAlignment="Center" Margin="4,0,12,0"/>
    <Button Grid.Column="1" Click="ToggleExpanded" Padding="0" Background="Transparent" HorizontalContentAlignment="Stretch">
     <TextBlock x:Name="CompactTitle" Text="Tisa Dynamic Island" TextTrimming="CharacterEllipsis" MaxWidth="450"/>
    </Button>
    <StackPanel Grid.Column="2" Orientation="Horizontal">
     <TextBlock x:Name="Battery" FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
     <Button Content="⌄" Click="ToggleExpanded" ToolTip="Expand or collapse"/>
    </StackPanel>
   </Grid>
   <StackPanel x:Name="Expanded" Visibility="Collapsed">
    <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
     <Button Content="Home" Tag="Home" Click="SelectTab"/><Button Content="Clipboard" Tag="Clipboard" Click="SelectTab"/>
     <Button Content="Downloads" Tag="Downloads" Click="SelectTab"/><Button Content="Shelf" Tag="Shelf" Click="SelectTab"/>
     <Button Content="Settings" Tag="Settings" Click="SelectTab"/>
    </StackPanel>
    <Grid Height="180">
     <Grid x:Name="HomePage">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#253F5360" CornerRadius="16" Padding="18" Margin="0,0,10,0">
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="NOW PLAYING" Foreground="{StaticResource Accent}" FontSize="10" Margin="0,0,0,12"/>
        <TextBlock x:Name="TrackTitle" Text="Nothing playing" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="TrackArtist" Opacity="0.6" Margin="0,4,0,10" TextTrimming="CharacterEllipsis"/>
        <StackPanel Orientation="Horizontal"><Button x:Name="PreviousButton" Content="Previous" Tag="previous" Click="MediaCommand"/>
         <Button x:Name="PlayButton" Content="Play" Tag="toggle" Click="MediaCommand" Background="#39695E"/>
         <Button x:Name="NextButton" Content="Next" Tag="next" Click="MediaCommand"/></StackPanel>
       </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#203F5360" CornerRadius="16" Padding="16">
       <StackPanel VerticalAlignment="Center"><TextBlock x:Name="Today" FontSize="23"/>
        <TextBlock x:Name="Summary" TextWrapping="Wrap" Opacity="0.7" Margin="0,10,0,8"/>
        <Button Content="Open Downloads" Click="OpenDownloads"/></StackPanel>
      </Border>
     </Grid>
     <Grid x:Name="ClipboardPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <DockPanel><Button Content="Clear history" Click="ClearClipboard" DockPanel.Dock="Right"/>
       <TextBlock x:Name="ClipboardHint" Text="Copied items stay in memory. Click to copy again." VerticalAlignment="Center"/></DockPanel>
      <ListBox x:Name="ClipboardList" Grid.Row="1" SelectionChanged="CopyEntry">
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <Grid x:Name="DownloadsPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock x:Name="DownloadHint" Text="Watching Chrome, Edge and Firefox partial files in Downloads." Margin="0,4,0,8"/>
      <ListBox x:Name="DownloadsList" Grid.Row="1"><ListBox.ItemTemplate><DataTemplate>
       <StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6"/></StackPanel>
      </DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid>
     <Grid x:Name="ShelfPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <DockPanel><Button Content="Clear shelf" Click="ClearShelf" DockPanel.Dock="Right"/><TextBlock Text="Drop files here • double-click to open • drag to another app" VerticalAlignment="Center"/></DockPanel>
      <ListBox x:Name="ShelfList" Grid.Row="1" MouseDoubleClick="OpenShelfItem" PreviewMouseLeftButtonDown="BeginShelfDrag" PreviewMouseMove="DragShelfItem"/>
     </Grid>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,0">
      <CheckBox x:Name="ClipboardToggle" Content="Keep clipboard history in memory" Foreground="White" Margin="6" Click="SaveSettings"/>
      <CheckBox x:Name="DownloadsToggle" Content="Watch the Downloads folder" Foreground="White" Margin="6" Click="SaveSettings"/>
      <CheckBox x:Name="HoverToggle" Content="Expand on hover" Foreground="White" Margin="6" Click="SaveSettings"/>
      <TextBlock Text="Ctrl + Alt + Space toggles the island. Right-click the tray icon to quit." Opacity="0.6" FontSize="12" Margin="6,12,0,0"/>
      <Expander x:Name="FeatureAvailability" Header="Feature availability on Windows" Foreground="White" Margin="6,12,0,4">
       <StackPanel Margin="8,10,8,8">
        <TextBlock Text="Only available Windows features appear in the tabs and settings." TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="macOS only" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
        <TextBlock Text="AirDrop, Apple's Liquid Glass material and Apple SMC fan control are macOS features. They are not included on Windows." TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,12"/>
        <TextBlock Text="Not yet in this Windows build" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
        <TextBlock Text="Photo Booth, camera effects, Khmer calendar and routines, AI usage, editable Home widgets, microphone controls and advanced audio controls are not yet available. Their controls are hidden." TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,12"/>
        <TextBlock Text="PC fan control" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
        <TextBlock Text="PC fan support depends on your hardware. Fan controls are hidden in this build until support for your PC is available." TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0"/>
       </StackPanel>
      </Expander>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <TextBlock x:Name="Status" FontSize="11" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" Margin="4,12,0,0"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
